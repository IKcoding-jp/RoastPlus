NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-roastplus-e2e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-roastplus-e2e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-roastplus-e2e.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:e2e
NEXT_PUBLIC_E2E_MODE=true
# 生産記録などの実Firestoreを使う機能のE2E用。Firestoreエミュレータへ接続する。
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

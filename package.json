{
  "name": "roastplus",
  "version": "0.18.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:prod": "firebase use default && npm run build && firebase deploy",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "tsx scripts/run-rules-tests.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "secrets:scan": "gitleaks git --redact --no-banner --log-opts=\"origin/main..HEAD\"",
    "secrets:scan:staged": "gitleaks git --staged --redact --no-banner",
    "security": "npm audit --audit-level=high",
    "complexity": "lizard ./app ./components ./hooks ./lib ./types ./scripts -C 15 -L 50 -w",
    "deadcode": "knip",
    "maintenance": "npm run complexity && npm run security && npm run deadcode && npm run skill:validate",
    "skill:validate": "tsx scripts/validate-ui-skill.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:ui": "tsx scripts/run-e2e.ts --ui",
    "test:e2e:report": "playwright show-report",
    "docs:check": "tsx scripts/check-docs-consistency.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "framer-motion": "^12.36.0",
    "lottie-react": "^2.4.1",
    "next": "^16.0.8",
    "next-themes": "^0.4.6",
    "phosphor-react": "^1.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.8",
    "firebase-tools": "^15.18.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.3",
    "postcss": "^8.5.10",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "firebase-tools": {
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.15"
    },
    "universal-analytics": {
      "uuid": "14.0.0"
    }
  }
}
